  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "r > g シミュレーター",
    "description": "資本収益率と経済成長率を比較し、インフレを考慮した資本ストック・国民所得の名目値と実質値を期間別に試算するツール。",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any",
    "browserRequirements": "JavaScript",
    "inLanguage": "ja",
    "isAccessibleForFree": true
  }
  </script>
  <style>
    :root {
      color-scheme: light;
      font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
      color: #1b1b1b;
      background: #fff;
      font-synthesis: none;
    }
    * { box-sizing: border-box; }
    body { margin: 0 auto; padding: 36px 20px 60px; max-width: 1140px; line-height: 1.65; }
    h1 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 12px; line-height: 1.35; }
    h2 { font-size: 1.2rem; margin: 38px 0 12px; }
    p { margin: 0 0 15px; }
    .intro, .notes { max-width: 78ch; }
    .muted, .notes, small { color: #585858; }
    form { margin: 30px 0 26px; }
    .fields { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 18px; }
    label { display: block; font-weight: 600; font-size: .91rem; margin-bottom: 5px; }
    input, select, button { font: inherit; }
    input, select { width: 100%; min-width: 0; padding: 9px 10px; border: 1px solid #aaa; border-radius: 3px; background: #fff; color: inherit; }
    input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid #1f5fbf; outline-offset: 2px; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-top: 20px; }
    button { padding: 9px 16px; border: 1px solid #6f6f6f; border-radius: 3px; background: #fff; color: inherit; cursor: pointer; }
    button.primary { background: #222; color: white; border-color: #222; }
    button:hover:not(:disabled) { border-color: #222; }
    button:disabled { cursor: not-allowed; opacity: .45; }
    #copy-status { font-size: .85rem; color: #555; }
    #error, #warning { border-left: 3px solid #888; padding-left: 12px; }
    #error { color: #a12626; border-color: #a12626; }
    #warning { color: #6c4500; border-color: #9d7100; }
    #summary { margin: 0 0 14px; }
    .table-wrap { max-width: 100%; overflow-x: auto; border-top: 1px solid #aaa; }
    table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .87rem; white-space: nowrap; }
    caption { padding: 12px 0; text-align: left; font-weight: 600; }
    th, td { padding: 9px 12px; border-bottom: 1px solid #e6e6e6; text-align: right; }
    thead th { background: #f8f8f8; border-bottom: 1px solid #aaa; font-weight: 600; }
    th:first-child, td:first-child { text-align: left; }
    tbody tr:hover { background: #fafafa; }
    code { font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; overflow-wrap: anywhere; }
    .formula { margin: 7px 0; }
    footer { margin-top: 38px; padding-top: 14px; border-top: 1px solid #ddd; font-size: .88rem; color: #555; }
    [hidden] { display: none !important; }
    @media (max-width: 780px) { .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 480px) { body { padding: 24px 14px 48px; } .fields { grid-template-columns: 1fr; gap: 12px; } .actions button { flex-grow: 1; } }
